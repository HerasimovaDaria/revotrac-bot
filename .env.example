DISCORD_BOT_TOKEN=your_discord_bot_token_here
LEAD_USER_ID=your_discord_user_id_here
RENORMALIZE_TOKEN=your_renormalize_jwt_token_here
# Default daily-reports channel (text or forum) for subscribers who didn't run !setchannel;
# leave empty for no default
REPORTS_CHANNEL_ID=1508418927644901486
# SQLite file path; on Railway point it to the mounted Volume (e.g. /data/hours.db)
DB_PATH=hours.db
# Evening reminder time (UTC+2) for people without a daily report today
REMINDER_TIME=19:00
# "Hasn't started work yet" alert (UTC+2) — 0 hours logged and no day off by this time
MIDDAY_CHECK_TIME=13:00
